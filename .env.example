# =========================================================
# MURDER MYSTIQL: LCU ECLIPSE - Environment Configuration
# =========================================================

# ---------------------------------------------------------
# 1. FRONTEND / BUILD ENVIRONMENT VARIABLES (Vite / Public)
# ---------------------------------------------------------
# Public Firebase Web App client configuration only.
# Safe to expose in the frontend bundle. DO NOT PUT SECRETS HERE.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=murder-mystiql.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=murder-mystiql
VITE_FIREBASE_STORAGE_BUCKET=murder-mystiql.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

# ---------------------------------------------------------
# 2. BACKEND SERVER-ONLY SECRETS (FastAPI / Serverless)
# ---------------------------------------------------------
# CRITICAL: These must NEVER be prefixed with VITE_ or exposed to the frontend!

APP_ENV=development
SESSION_SECRET=generate-a-strong-secret-key-here-minimum-32-chars

# Firebase Admin SDK Credentials (Server-side cryptographic token verification)
FIREBASE_PROJECT_ID=murder-mystiql
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@murder-mystiql.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Supabase Production Database Configuration
SUPABASE_URL=https://vtaqddbmdteiwsswnwlz.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Session Pooler (PostgreSQL) connection string
# Format: postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:5432/postgres
SUPABASE_DATABASE_URL=postgresql://postgres.vtaqddbmdteiwsswnwlz:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Runtime & Investigation Policy Controls
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173
MAX_QUERY_ROWS=200
QUERY_TIMEOUT_MS=3000